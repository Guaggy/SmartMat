#pragma once

// Copy this file to secrets.h (already in .gitignore, so it never gets
// pushed to git) and fill in your own values below.

const char* wifi_ssid = "your-wifi-name";
const char* wifi_password = "your-wifi-password";

const char* mqtt_broker_ip = "192.168.1.50";  // static/reserved IP of your Raspberry Pi
const uint16_t mqtt_port = 1883;
const char* mqtt_username = "your-mqtt-username";
const char* mqtt_password = "your-mqtt-password";

// Service key: lets whoever knows it write the mat's factory passport slot and serial number (PASSPORT.md).
// Leave it empty to make both read-only on this board. Pick a long random string and keep it off the customers' mats.
const char* passport_service_key = "";
